# ---- Site ----
# Your live address, no trailing slash. PayFast and Bob Go send updates here.
SITE_URL=https://your-store.vercel.app

# ---- Admin login ----
# The password you type at /admin/login. Use 16+ characters.
ADMIN_PASSWORD=
# A long random string that signs the admin login cookie (generate one: openssl rand -hex 32)
SESSION_SECRET=
# Protects the expiry cron endpoint (any long random string)
CRON_SECRET=

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- PayFast ----
# "true" while testing on sandbox.payfast.co.za, "false" when live
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# The "Salt Passphrase" set in PayFast Settings (sandbox default shown)
PAYFAST_PASSPHRASE=jt7NOE43FZPn

# ---- Bob Go ----
# "true" for api.sandbox.bobgo.co.za, "false" for live
BOBGO_SANDBOX=true
BOBGO_API_KEY=
# Settings -> Webhook subscriptions -> secret (used to verify Bob Go updates)
BOBGO_WEBHOOK_SECRET=
